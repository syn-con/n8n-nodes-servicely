{
  "name": "@syn-con/n8n-nodes-servicely",
  "version": "0.8.0",
  "description": "n8n community node for the Servicely ITSM/ESM JSON REST API (v1)",
  "keywords": [
    "n8n-community-node-package",
    "servicely",
    "itsm",
    "esm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/syn-con/n8n-nodes-servicely#readme",
  "author": {
    "name": "Syn-Con",
    "url": "https://github.com/syn-con"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syn-con/n8n-nodes-servicely.git"
  },
  "bugs": {
    "url": "https://github.com/syn-con/n8n-nodes-servicely/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ServicelyApi.credentials.js",
      "dist/credentials/ServicelyAIToolAuthApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Servicely/Servicely.node.js",
      "dist/nodes/Servicely/ServicelyTrigger.node.js",
      "dist/nodes/ServicelyAITool/ServicelyAITool.node.js",
      "dist/nodes/ServicelyAITool/ServicelyAIToolTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:watch": "tsc --watch",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint nodes credentials index.ts package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
